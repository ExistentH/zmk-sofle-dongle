#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    macros {
        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
&kp GRAVE     &kp B         &kp Y         &kp O         &kp U         &kp SQT       &kp DOWN      &kp DQT       &kp L         &kp D         &kp W         &kp V         &kp Z
&kp UNDER     &kp C         &kp I         &kp E         &kp A         &kp COMMA     &kp LEFT      &kp DOT       &kp H         &kp T         &kp S         &kp N         &kp Q
&kp HASH      &kp Z         &kp X         &kp C         &kp V         &kp MINUS     &kp RIGHT     &kp QMARK     &kp R         &kp M         &kp F         &kp P         &kp RG(DOT)
&kp C_MUTE    &kp LS(TAB)   &kp TAB       &kp RET       &kp SPACE     &kp BSPC      &kp RET       &sl 2         &sl 1         &kp LC(BSPC)  &kp CAPS      &to 2
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;

            display-name = "layer_home";
        };

        layer_1 {
            bindings = <
&trans        &trans        &trans        &mo 3         &trans        &trans        &trans        &trans        &trans        &mo 3         &trans        &trans        &trans
&kp RG(E)     &kp LS(B)     &kp LS(Y)     &kp LS(O)     &kp LS(U)     &kp AT        &trans        &kp DQT       &kp LS(L)     &kp LS(D)     &kp LS(W)     &kp LS(V)     &kp LS(Z)
&kp RG(A)     &kp LS(C)     &kp LS(I)     &kp LS(E)     &kp LS(A)     &kp SEMI      &trans        &kp COLON     &kp LS(H)     &kp LS(T)     &kp LS(S)     &kp LS(N)     &kp LS(Q)
&kp RG(SLASH) &kp LS(Z)     &kp LS(X)     &kp LS(C)     &kp LS(V)     &kp RG(DOT)   &trans        &kp EXCL      &kp LS(R)     &kp LS(M)     &kp LS(F)     &kp LS(P)     &kp RG(N)
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
            >;

            display-name = "layer_shift";
            sensor-bindings = <&rsr_vol &rsr_trans>;

        };

        layer_2 {
            bindings = <
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&kp RG(0)     &kp DLLR      &kp N6        &kp N8        &kp DOT       &kp LBKT      &trans        &kp RBKT      &kp COMMA     &kp N9        &kp N7        &kp PLUS      &kp TILDE
&kp PIPE2     &kp EQUAL     &kp N4        &kp N1        &kp N2        &kp LPAR      &trans        &kp RPAR      &kp N3        &kp N0        &kp N5        &kp MINUS     &kp EXCL
&kp AMPS      &kp RG(=)     &kp PRCNT     &kp COLON     &kp SLASH     &kp LBRC      &trans        &kp RBRC      &kp ASTRK     &kp LT        &kp GT        &kp CARET     &kp PIPE
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
            >;
             display-name = "layer_num";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            bindings = <
&trans        &kp LC(X)     &kp LC(A)     &none         &kp LC(C)     &kp LC(V)     &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
            >;
   display-name = "layer_edit";
        };
    };
};
