#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0

#define HOME_EN 1
#define SHFT_EN 2
#define NUMS_EN 3

#define HOME_PT 4
#define SHFT_PT 5
#define NUMS_PT 6

#define HOME_RU 7
#define SHFT_RU 8
#define NUMS_RU 9

#define HOME_ES 10
#define SHFT_ES 11
#define NUMS_ES 12

#define EDIT 13
#define LANG 14
#define HEXA 15

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    macros {
        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
        lang_en: lang_en {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;

        bindings =
            <&macro_press &kp LSHIFT &kp LALT>,
            <&macro_tap &kp N0>,
            <&macro_release &kp LALT &kp LSHIFT>,
            <&macro_tap &to HOME_EN>;
        };
        lang_pt: lang_pt {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;

        bindings =
            <&macro_press &kp LSHIFT &kp LALT>,
            <&macro_tap &kp N1>,
            <&macro_release &kp LALT &kp LSHIFT>,
            <&macro_tap &to HOME_PT>;
        };
        pt_low_a_grv: pt_low_a_grv {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;

        bindings =
            <&kp LBRC>,
            <&kp A>;
        };
        pt_upp_a_grv: pt_upp_a_grv {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;

        bindings =
            <&kp LBRC>,
            <&kp LS(A)>;
        };
        lang_ru: lang_ru {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;

        bindings =
            <&macro_press &kp LSHIFT &kp LALT>,
            <&macro_tap &kp N2>,
            <&macro_release &kp LALT &kp LSHIFT>,
            <&macro_tap &to HOME_RU>;
        };
        lang_es: lang_es {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;

        bindings =
            <&macro_press &kp LSHIFT &kp LALT>,
            <&macro_tap &kp N3>,
            <&macro_release &kp LALT &kp LSHIFT>,
            <&macro_tap &to HOME_ES>;
        };
        es_low_u_dia: es_low_u_dia {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;

        bindings =
            <&kp LBRC>,
            <&kp U>;
        };
        es_upp_u_dia: es_upp_u_dia {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;

        bindings =
            <&kp LBRC>,
            <&kp LS(U)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp LC(DEL)   &kp LS(TAB)   &kp RET       &kp BSPC      &kp TAB       &kp DEL       &mmv MOVE_UP    &kp HOME      &kp UP        &kp LEFT      &kp RIGHT     &kp DOWN      &kp END
&none         &none         &none         &none         &none         &none         &mmv MOVE_DOWN  &none         &none         &none         &none         &none         &none
&none         &lang_es      &lang_ru      &lang_pt      &lang_en      &none         &mmv MOVE_LEFT  &none         &none         &none         &none         &none         &none
&none         &none         &none         &none         &none         &none         &mmv MOVE_RIGHT &none         &none         &none         &none         &none         &none
&kp C_MUTE    &none         &none         &mo EDIT      &kp SPACE     &kp LC(BSPC)  &mkp LCLK       &none         &none         &mo LANG      &none         &none
            >;
            display-name = "Base";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        #include "languages/english.dtsi"
        #include "languages/portuguese.dtsi"
        #include "languages/russian.dtsi"
        #include "languages/spanish.dtsi"

        editing {
            bindings = <
&trans        &kp LC(LS(ESC)) &kp C_AL_CALC &kp PSCRN &kp C_AL_MY_COMPUTER &trans       &kp UP        &kp LC(HOME)  &kp LC(UP)    &kp LC(LEFT)  &kp LC(RIGHT) &kp LC(DOWN)  &kp LC(END)
&kp LG(D)     &kp LC(LS(TAB)) &kp LC(TAB)   &kp LA(TAB)   &kp LS(LA(TAB)) &kp LA(F4)    &kp DOWN      &none         &none         &kp K_FORWARD &kp K_BACK    &none         &none
&kp LC(S)     &kp LC(X)       &kp LC(A)     &kp LC(C)     &kp LC(V)       &kp LC(Z)     &kp LEFT      &kp F5        &kp F2        &kp LC(L)     &kp F3        &kp F12       &kp F11
&kp ESC       &kp LC(LS(V))   &kp LC(LS(T)) &kp LC(W)     &kp LC(T)       &kp LC(LS(Z)) &kp RIGHT     &none         &none         &none         &none         &none         &none
&none         &none           &none         &none         &none           &none         &kp LCTRL     &kp LSHFT     &none         &none         &none         &none
            >;
            display-name = "Edit";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        language {
            bindings = <
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &lang_es      &lang_ru      &lang_pt      &lang_en      &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
            >;
            display-name = "Lang";
        };

        hexadecimal {
            bindings = <
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&kp D         &kp A         &kp KP_N3     &kp KP_N4     &kp KP_N7     &kp DOT       &trans        &trans        &trans        &trans        &trans        &trans        &trans
&kp B         &kp F         &kp KP_N0     &kp KP_N1     &kp KP_N2     &kp KP_N9     &trans        &trans        &kp F2        &kp LC(L)     &kp F3        &kp F12       &trans
&kp E         &kp C         &kp KP_N5     &kp KP_N6     &kp KP_N8     &kp COMMA     &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &kp ENTER     &kp PLUS      &kp MINUS     &trans        &kp LALT      &trans        &trans        &trans        &trans
            >;
            display-name = "Hexa";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
